# LOGIC4 switch matrix (G1 minimal): 4 tracks per edge (N/E/S/W), 4 BELs.
# Format: destination,[source|source|...]  one "sink,source" pair per line (FABulous 2.2.0)
# BEL inputs: each LUT input pin selects one of the 4 tracks of one input edge
# plus the shared local jump wires; coverage is deliberately sparse.

LA_I0,N1END0
LA_I0,E1END0
LA_I0,S1END0
LA_I0,W1END0
LA_I1,N1END1
LA_I1,E1END1
LA_I1,S1END1
LA_I1,W1END1
LA_I2,N1END2
LA_I2,E1END2
LA_I2,S1END2
LA_I2,W1END2
LA_I3,N1END3
LA_I3,E1END3
LA_I3,S1END3
LA_I3,W1END3
LB_I0,N1END0
LB_I0,E1END0
LB_I0,S1END0
LB_I0,W1END0
LB_I1,N1END1
LB_I1,E1END1
LB_I1,S1END1
LB_I1,W1END1
LB_I2,N1END2
LB_I2,E1END2
LB_I2,S1END2
LB_I2,W1END2
LB_I3,N1END3
LB_I3,E1END3
LB_I3,S1END3
LB_I3,W1END3
LC_I0,N1END0
LC_I0,E1END0
LC_I0,S1END0
LC_I0,W1END0
LC_I1,N1END1
LC_I1,E1END1
LC_I1,S1END1
LC_I1,W1END1
LC_I2,N1END2
LC_I2,E1END2
LC_I2,S1END2
LC_I2,W1END2
LC_I3,N1END3
LC_I3,E1END3
LC_I3,S1END3
LC_I3,W1END3
LD_I0,N1END0
LD_I0,E1END0
LD_I0,S1END0
LD_I0,W1END0
LD_I1,N1END1
LD_I1,E1END1
LD_I1,S1END1
LD_I1,W1END1
LD_I2,N1END2
LD_I2,E1END2
LD_I2,S1END2
LD_I2,W1END2
LD_I3,N1END3
LD_I3,E1END3
LD_I3,S1END3
LD_I3,W1END3

# BEL control: shared reset and per-slice enable come from the jump wires
# (J_SR_BEG / J_EN_BEG are driven from the tracks below).
LA_EN,J_EN_END0
LA_SR,J_SR_END0
LB_EN,J_EN_END1
LB_SR,J_SR_END0
LC_EN,J_EN_END2
LC_SR,J_SR_END0
LD_EN,J_EN_END3
LD_SR,J_SR_END0

# Track drivers: every output track can take the 4 BEL outputs and the
# two non-opposite straight-through tracks of the same index.
N1BEG0,LA_O
N1BEG0,LB_O
N1BEG0,LC_O
N1BEG0,LD_O
N1BEG0,E1END0
N1BEG0,S1END0
N1BEG0,W1END0
N1BEG1,LA_O
N1BEG1,LB_O
N1BEG1,LC_O
N1BEG1,LD_O
N1BEG1,E1END1
N1BEG1,S1END1
N1BEG1,W1END1
N1BEG2,LA_O
N1BEG2,LB_O
N1BEG2,LC_O
N1BEG2,LD_O
N1BEG2,E1END2
N1BEG2,S1END2
N1BEG2,W1END2
