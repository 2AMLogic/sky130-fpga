# Control-jump drivers: reset/enable are routed in from the tracks.
J_EN_BEG0,N1END0
J_EN_BEG0,E1END0
J_EN_BEG0,S1END0
J_EN_BEG0,W1END0
J_EN_BEG1,N1END1
